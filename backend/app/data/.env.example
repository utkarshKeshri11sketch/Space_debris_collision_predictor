# Copy these settings into the deployment environment (this file is not auto-loaded).
# Unset CELESTRAK_URL uses active + NAME=DEB + NAME=R/B, always OMM JSON.
# An override replaces the primary feed; the debris/body feeds remain enabled.
CELESTRAK_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=JSON
CATALOG_MIN_REFRESH_SECONDS=7200
# Default is <system temp>/orbitsentinel/catalog.json; use /tmp on Lambda.
CATALOG_CACHE_PATH=/tmp/orbitsentinel/catalog.json
S3_BUCKET=
CATALOG_S3_KEY=orbitsentinel/catalog.json
AWS_REGION=us-east-1
# Comma-separated IDs with operator-verified maneuver capability. Empty by default.
# Active-feed membership or an operational SATCAT status alone does NOT prove it.
CATALOG_MANEUVERABLE_IDS=
