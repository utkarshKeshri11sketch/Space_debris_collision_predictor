# Copy to .env (never commit .env)
ALLOWED_ORIGINS=*
# CelesTrak GP (OMM JSON). Refresh at most once per 2 hours.
CELESTRAK_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=json
CATALOG_MIN_REFRESH_SECONDS=7200
S3_BUCKET=
AWS_REGION=us-east-1
# AI (Amazon Bedrock, Gemini/cached fallback)
BEDROCK_MODEL_ID=
GEMINI_API_KEY=
