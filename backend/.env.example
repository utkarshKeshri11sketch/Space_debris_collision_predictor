# OrbitSentinel backend settings. Copy what you need into your environment (never commit real keys).
ALLOWED_ORIGINS=*

# --- Data: Space-Track catalog (app/data/spacetrack.py) -----------------------------------------
# Free account at https://www.space-track.org/auth/createAccount. With both set, `python -m
# app.data.refresh` downloads from Space-Track and never contacts CelesTrak. Never commit real values.
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=
# CATALOG_SOURCE=spacetrack             spacetrack | celestrak (default: spacetrack when credentials are set)

# --- Data: CelesTrak catalog (app/data) ---------------------------------------------------------
# Refresh with `python -m app.data.refresh` (or the EventBridge handler app.data.refresh.refresh_handler).
# Default feeds: GROUP=active + NAME=DEB + NAME=R/B, OMM JSON. CelesTrak serves each query at most
# once per 2-hour data update per network; a refresh never runs on a user request.
# CELESTRAK_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=JSON
CATALOG_MIN_REFRESH_SECONDS=7200
# Default cache: <system temp>/orbitsentinel/catalog.json (use /tmp on Lambda)
# CATALOG_CACHE_PATH=/tmp/orbitsentinel/catalog.json
S3_BUCKET=
CATALOG_S3_KEY=orbitsentinel/catalog.json
AWS_REGION=us-east-1
# Maneuverable = active payload in one of these fleets (name prefix) or listed by NORAD id.
# CATALOG_PROPULSIVE_FLEETS=STARLINK,ONEWEB,KUIPER,ISS (ZARYA),CSS (TIANHE)
CATALOG_MANEUVERABLE_IDS=

# --- Screening (app/physics/screening.py) -------------------------------------------------------
# Watch-list = ISS + the closest cross-operator maneuverable pairs from CelesTrak SOCRATES.
# WATCHLIST_PAIRS=1
# SCREENING_TARGET_IDS=25544,48212      overrides the whole watch-list
# SCREENING_PC_MODEL=max                max = worst-case Pc (no covariance in GP data); assumed = per-type covariance
# SCREENING_WARMUP=1                    0 disables the background screening warm-up

# --- AI (app/ai) — free providers only; chain groq > gemini > cerebras > cached ---------------
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
# AI_NEGOTIATION_PACE_S=0.7
# AI_BRIEF_MODE=llm                     template = never call a model for the brief
