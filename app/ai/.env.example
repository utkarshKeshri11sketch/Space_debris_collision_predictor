# AI layer settings. Copy the lines you need into the repo-level .env (never commit real keys).
# FREE PROVIDERS ONLY: all three below have a free tier; do not add a paid provider.

# Where the fallback chain starts: groq | gemini | cerebras | cached
# Chain order is groq > gemini > cerebras > cached; a provider without a key is skipped.
# "cached" makes zero API calls and replays app/ai/cache/ (the offline demo).
LLM_PROVIDER=groq

GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Optional model overrides (free-tier model names change; defaults were verified on 2026-10-30,
# except the Cerebras default, which is unverified)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# CEREBRAS_MODEL=llama-3.3-70b

# Optional tuning
# AI_COOLDOWN_S=60               seconds to skip a provider after an error (15 s after a 429)
# AI_MAX_TOKENS=400
# AI_NEGOTIATION_PACE_S=0.7      minimum gap between streamed negotiation events
# AI_NEGOTIATION_REBUTTALS=1     0 = skip the rebuttal round (fewer API calls, ~2 s faster)
# AI_BRIEF_MODE=llm              template = never call a model for the brief
# AI_RECORD_CACHE=1              only used by scripts/build_ai_cache.py
